# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

# A Awin tem DUAS credenciais diferentes. Aqui vai a do Product Feed:
# painel Awin > Toolbox > Create-a-Feed > link "Download list", que tem o
# formato https://productdata.awin.com/datafeed/list/apikey/SUA_CHAVE/
# Copie o trecho depois de /apikey/.
# O token de ui.awin.com/awin-api e da Publisher API e NAO funciona aqui.
AWIN_PRODUCTDATA_KEY=sua_chave_de_product_feed_aqui

AWIN_PUBLISHER_ID=3027383

# ATENCAO: aqui vai o *Feed ID*, nao o Advertiser ID -- sao numeros diferentes.
# Passar o Advertiser ID faz o download do feed retornar 404.
# Rode `python listar_feeds.py` para ver os Feed IDs da sua conta.
AWIN_FEED_IDS=

# Filtros (opcionais -- se nao definir, usa o padrao do script)
# DESCONTO_MINIMO_PCT=20
# PALAVRAS_CHAVE=fone,carregador,cabo,mouse,teclado
# MAX_OFERTAS_POR_LOJA=30
