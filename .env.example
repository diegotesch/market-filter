# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

# A Awin tem DUAS credenciais diferentes. Aqui vai a do Product Feed:
# painel Awin > Toolbox > Create-a-Feed > caixa "Feed List Download".
# A URL de la tem o formato
#   https://productdata.awin.com/datafeed/list/apikey/SUA_CHAVE/
# Copie o trecho depois de /apikey/.
# O token de ui.awin.com/awin-api e da Publisher API e NAO funciona aqui.
AWIN_PRODUCTDATA_KEY=sua_chave_de_product_feed_aqui

# Quais feeds baixar. Deixe vazio para pegar automaticamente todos os feeds
# da regiao definida abaixo. Use `python listar_feeds.py` para ver os IDs.
# Atencao: e o Feed ID, nao o Advertiser ID.
AWIN_FEED_IDS=
AWIN_REGIAO=BR
AWIN_IDIOMA=pt

# --- Deteccao de oferta (opcionais) ---
# Estes feeds nao publicam preco cheio, entao "oferta" e queda em relacao ao
# maior preco ja observado pelo historico.
# QUEDA_MINIMA_PCT=10     # queda minima para virar oferta
# MIN_OBSERVACOES=2       # quantas vezes precisamos ter visto o produto antes
# MAX_OFERTAS=100

# Filtro por palavra-chave no nome do produto. Vazio = nao filtra.
# PALAVRAS_CHAVE=tenis,sandalia
